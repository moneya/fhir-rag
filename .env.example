# Copy to .env. Gitignored; never put a real key in .env.example.
#
# Embeddings need ONE of these (or none, with --embedder ollama):
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Generation (answering from retrieved chunks)
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides
# OLLAMA_BASE_URL=http://localhost:11434/v1
# FHIR_RAG_CACHE=.cache/embeddings
